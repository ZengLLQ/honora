{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tutor Payment Records",
  "version": "0.1.0",
  "identifier": "com.tutor.paymentrecords",
  "mainBinaryName": "tutor-payment-records",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Tutor Payment Records",
        "width": 1440,
        "height": 900,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "Tutor Payment Records",
    "copyright": "Copyright © 2026 Tutor Payment Records. All rights reserved.",
    "category": "Finance",
    "shortDescription": "A desktop application for private tutors to record, organize, audit, and review student bank transfer receipts.",
    "longDescription": "Tutor Payment Records provides offline-first payment tracking, local SQLite persistence, automatic receipt compression, and financial auditing designed for private tutors.",
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico"
      },
      "wix": {
        "language": "en-US"
      }
    },
    "macOS": {
      "minimumSystemVersion": "10.13",
      "dmg": {
        "windowSize": {
          "width": 660,
          "height": 400
        },
        "appPosition": {
          "x": 180,
          "y": 170
        },
        "applicationFolderPosition": {
          "x": 480,
          "y": 170
        }
      }
    }
  }
}
